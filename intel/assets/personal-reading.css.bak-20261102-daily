/* Intuitive overview: compact information first, complete controls one click away. */
html{overflow-anchor:none;scroll-behavior:auto!important}
body .shell{max-width:1480px;padding:22px 32px 48px}
body .shell>[hidden],body .shell .view-heading-actions[hidden],[hidden]{display:none!important}
body .shell>.page-head{min-height:40px;margin:0 0 8px!important;display:flex!important;flex-direction:row;align-items:center;gap:12px}
body .shell>.page-head>div:first-child{display:flex;align-items:center;gap:8px}body .shell>.page-head h1{font-size:25px!important;margin:0!important;line-height:1.25}
body.video-reading .shell>.page-head .actions{display:flex!important}
body .page-head .actions{display:flex!important;gap:6px;align-items:center}body .page-head .actions button{min-height:34px;padding:6px 11px;font-size:13px}body .page-head .reading-info{display:none!important}
body .shell>.section-nav{position:sticky!important;top:0;z-index:10;background:var(--bg);display:flex;align-items:center;gap:25px;padding:5px 0!important;margin:0 0 16px!important;min-height:44px;overflow-x:auto;scrollbar-width:thin}
body .section-nav a{font-size:15px!important;line-height:22px!important;padding:8px 0!important;margin:0!important;min-height:38px;border-bottom:2px solid transparent!important;box-sizing:border-box;flex-shrink:0;color:var(--muted)!important;box-shadow:none!important}
body .section-nav a:first-child{font-weight:400}body .section-nav a.active,body.video-reading .section-nav a.active{border-bottom:2px solid var(--text)!important;font-weight:650;color:var(--text)!important}
body .section-nav a:focus:not(:focus-visible){outline:none}
/* The overlay must cover every sticky navigation and the canvas. */
body #overlay{position:fixed;inset:0;z-index:1000!important;background:#0005;backdrop-filter:blur(4px)}body #drawer{position:fixed;z-index:1010!important;inset:0 0 0 auto;width:min(680px,100vw);max-height:100dvh;overflow-y:auto;background:var(--panel);background-color:var(--panel)!important;opacity:1!important;backdrop-filter:none!important;box-shadow:-16px 0 60px #0002;transition:none!important;animation:none!important}body #toast{z-index:1100}
body:has(#drawer:not([hidden])){overflow:hidden}body:has(#drawer:not([hidden])) .section-nav{pointer-events:none}
body .shell>.command-hero.overview-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:0 24px;margin:0 0 20px!important;padding:18px 22px!important;border-radius:20px!important;min-height:0;align-items:start}
.overview-hero>.section-top{grid-column:1/-1;display:flex!important;gap:14px;align-items:center!important;margin:0 0 10px!important}.overview-hero>.section-top>div:first-child{flex:1;min-width:160px!important}
body .overview-hero .section-top h2{font-size:25px!important;line-height:1.35!important;margin:0!important;letter-spacing:-.6px}.overview-hero .overview-caption{margin:5px 0 0;font-size:12px;color:var(--muted)}
.overview-hero .header-style-control{padding:2px;gap:2px}.overview-hero .header-style-control button{font-size:11px!important;min-height:28px!important;padding:5px 8px!important}.overview-hero .flow-actions{margin:0!important}.overview-hero #motion-toggle{font-size:12px!important;min-height:30px!important;padding:5px 8px!important}.overview-hero #mode{display:none}.overview-hero #recommendation-basis{font-size:12px;min-height:30px;padding:5px 9px;white-space:nowrap}
body .overview-hero .live-scene{grid-column:1;grid-row:2;min-width:0;width:100%;height:244px!important;margin:0!important;border:0!important}.overview-hero .live-brand{width:18px!important;height:18px!important;padding:2px!important;gap:0;min-height:0!important}.overview-hero .live-brand span,.overview-hero .live-brand i,.overview-hero .live-brand .live-status{display:none!important}.overview-hero .live-brand img{width:14px;height:14px}.overview-hero .live-core-label{display:none!important}.overview-hero .live-scene::after{content:'情报';position:absolute;left:50%;top:49%;transform:translate(-50%,-50%);font-size:14px;font-weight:600;color:#fff;pointer-events:none}.overview-hero .section-top .reading-info{display:none!important}
body .overview-hero>.command-key,body .overview-hero>.flow-footer,body .overview-hero>.command-strip{display:none!important}
#priority-signals{grid-column:2;grid-row:2;min-width:0;padding:0 0 0 20px;border-left:1px solid var(--line);align-self:stretch}.priority-label{display:flex;justify-content:space-between;gap:10px;font-size:13px;font-weight:600;padding:0 0 6px;color:var(--text)}.priority-label small{font-size:11px;font-weight:400;color:var(--muted)}
body button.priority-signal{width:100%;text-align:left;display:grid;grid-template-columns:25px minmax(0,1fr) 16px;align-items:start;gap:9px;padding:12px 0;border:0;border-radius:0;background:transparent!important;color:var(--text)!important;box-shadow:none;min-height:100px;cursor:pointer}.priority-signal+.priority-signal{border-top:1px solid var(--line)}.priority-number{font-size:15px;font-weight:650;color:var(--muted);padding-top:19px}.priority-copy{display:flex;flex-direction:column;gap:5px;min-width:0}.priority-copy small{font-size:11px;line-height:17px;color:var(--muted)}.priority-copy strong{font-size:18px;line-height:1.45;font-weight:650;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.priority-copy>span{font-size:12px;line-height:1.6;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.priority-empty{padding:25px 0;font-size:15px;color:var(--muted)}
#focus,#video-radar{padding:0 0 24px!important;margin:0!important;scroll-margin-top:0}body .focus-heading,body .video-page-head{display:flex!important;align-items:center!important;justify-content:space-between;gap:12px;min-height:38px!important;margin:0 0 10px!important}.focus-heading>div:first-child,.video-page-head>div:first-child{display:flex!important;align-items:center;gap:8px;flex-wrap:wrap;min-width:0}.focus-heading h2,.video-page-head h2{font-size:21px!important;line-height:1.4!important;margin:0!important;padding:0!important;white-space:nowrap}.view-heading-actions{position:static!important;display:flex;align-items:center;gap:6px}.view-heading-actions button,.focus-heading button{font-size:12px!important;min-height:30px!important;padding:5px 9px!important}.focus-heading .reading-info{display:none!important}.view-context{font-size:12px!important;color:var(--muted);margin:0!important}.video-page-head .view-context{flex-basis:100%}
.focus-toolbar,.video-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:34px;margin:0 0 8px!important}.focus-tabs,#video-tabs{display:flex;gap:4px!important;margin:0!important;padding:2px;background:var(--panel2);border-radius:9px;flex-wrap:wrap}.focus-tabs button,#video-tabs button{font-size:12px!important;line-height:20px;min-height:30px!important;padding:4px 9px!important;border-radius:7px!important}#focus-search,#video-search{width:240px;max-width:240px;min-height:32px!important;font-size:13px!important;padding:5px 10px;margin:0}.view-result-status,#video-status{font-size:11px!important;line-height:18px!important;color:var(--muted);min-height:0!important;margin:0 0 8px!important}
body .signal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}body .focus-card,body .focus-card:first-child{grid-column:auto;padding:14px 16px 0!important;border-radius:14px;min-height:0;box-shadow:none;transform:none}.focus-card .focus-card-top{min-height:16px}.focus-card .focus-category{font-size:10px!important;padding:1px 5px}.focus-card .focus-order{font-size:11px}.focus-card h3,.focus-card:first-child h3{font-size:17px!important;line-height:1.45!important;margin:8px 0!important;font-weight:650;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.focus-card .focus-summary{font-size:12px!important;line-height:1.65!important;margin:4px 0 8px;-webkit-line-clamp:2;min-height:0}.focus-fit{padding:0;margin:0 0 5px;background:none!important;border:0;font-size:12px}.focus-fit summary{font-size:11px;color:var(--muted);cursor:pointer}.focus-card .focus-fit p{display:block!important;font-size:12px!important;line-height:1.65!important;margin:6px 0;overflow:visible;-webkit-line-clamp:unset}.focus-origin{padding-top:4px;margin-top:auto}.focus-origin img{width:20px!important;height:20px!important}.focus-origin strong{font-size:11px!important}.focus-origin small{font-size:10px!important}.focus-card-bottom{font-size:10px!important;padding:7px 16px!important;margin:8px -16px 0!important}.focus-card .focus-evidence{font-size:10px!important}
#reading-desk{margin-top:18px}.notice:not(.view-notice){display:none!important}#atlas-connection-state:not([hidden]){display:block!important}.restored-source-directory{margin:12px 0!important}#source-control .command-metrics{margin:15px 0!important}.video-summary{font-size:14px!important;line-height:1.7!important;padding:12px 16px!important;margin:0 0 14px!important;border-radius:12px!important}.video-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.video-card{border-radius:16px!important}
/* Original radar head layout: media left, the author's four rows right. */
#video-radar .video-card.head{display:grid;grid-template-columns:minmax(240px,.85fr) minmax(0,1.6fr);align-items:start;gap:22px;padding:18px;background:var(--panel)}
#video-radar .head:not(.has-media){grid-template-columns:minmax(0,1fr)}
#video-radar .h-media{min-width:0}#video-radar .video-cover{aspect-ratio:16/9;border-radius:10px;overflow:hidden}#video-radar .s-body{display:flex;flex-direction:column;gap:5px;padding:9px 0 0}#video-radar .s-title{font-size:12px;line-height:1.6;color:var(--text)}#video-radar .s-meta{font-size:10px;color:var(--muted)}#video-radar .h-text{min-width:0}#video-radar .h-text h3{font-size:21px!important;line-height:1.4!important;margin:5px 0 8px!important}#video-radar .video-card-label{font-size:11px;color:var(--muted);margin:0}#video-radar .verdict{font-size:13px;line-height:1.65;margin:5px 0 10px;color:var(--muted)}#video-radar .video-stats{font-size:11px;margin:5px 0;color:var(--muted)}#video-radar .h-rows{margin:0;display:grid;gap:8px}#video-radar .h-rows>div{display:grid;grid-template-columns:48px minmax(0,1fr);gap:10px}#video-radar .h-rows dt{font-size:11px;color:var(--muted);padding-top:2px}#video-radar .h-rows dd{font-size:13px;line-height:1.7;margin:0;color:var(--text)}#video-radar .video-card-actions{display:flex!important;flex-direction:row!important;flex-wrap:wrap;align-items:center;margin-top:12px;font-size:12px;gap:8px}#video-radar .video-card-actions>*{width:auto!important;min-width:0;flex:0 0 auto;white-space:nowrap}#video-radar .video-card-actions button{font-size:12px;min-height:30px;padding:5px 10px}
.focus-heading>div:first-child{min-width:0!important;width:auto!important;flex:1}.focus-heading>.view-heading-actions{min-width:0!important;width:auto!important;flex:0 0 auto}.overview-hero .live-scene::after{font-size:11px}
@media(max-width:650px){#video-radar .video-card.head{grid-template-columns:minmax(0,1fr);gap:12px;padding:13px}#video-radar .h-text h3{font-size:19px!important}#video-radar .h-rows dd{font-size:13px}}
/* All seven existing palettes also apply to the compact overview. */
body .command-hero.overview-hero{background:var(--panel)!important;color:var(--text)!important;border-color:var(--line)!important}body .overview-hero::before{display:none!important}body .overview-hero h2,body .overview-hero h2 em{color:var(--text)!important}body .overview-hero .header-style-control{background:var(--panel2)!important;border-color:var(--line)!important}body .overview-hero .header-style-control button{color:var(--muted)!important;background:transparent!important}body .overview-hero .header-style-control button.active{background:var(--text)!important;color:var(--panel)!important;box-shadow:none!important}body .overview-hero #motion-toggle{background:var(--panel)!important;color:var(--muted)!important;border-color:var(--line)!important}
@media(max-width:1000px){body .shell{padding:18px 22px}.overview-hero .overview-caption{max-width:320px}.overview-hero .flow-actions #motion-toggle{display:none}.priority-label small{display:none}body .signal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){body .shell{padding:12px 16px 32px}body .shell>.page-head{align-items:center!important;flex-direction:row!important;flex-wrap:nowrap!important;min-height:38px!important;margin-bottom:4px!important}body .shell>.page-head>div:first-child{width:auto!important;min-width:0!important;flex:1}body .page-head .actions{width:auto!important;flex-wrap:nowrap!important;min-width:0!important}body .shell>.page-head h1{font-size:21px!important}body .page-head #connection,body .page-head #refresh{display:none}body .page-head .actions button{font-size:11px;min-height:30px;padding:4px 8px}body .page-head .actions kbd{display:none}body .section-nav{gap:20px!important;margin-bottom:12px!important}body .section-nav a{font-size:13px!important}body .shell>.command-hero.overview-hero{grid-template-columns:minmax(0,1fr);gap:0;padding:13px 14px!important;margin-bottom:16px!important}.overview-hero>.section-top{flex-wrap:wrap;gap:7px!important;margin-bottom:0!important}.overview-hero>.section-top>div:first-child{flex-basis:100%}body .overview-hero .section-top h2{font-size:21px!important}.overview-hero .live-brand:nth-child(even){visibility:hidden}.overview-hero .overview-caption{font-size:10px;max-width:none}.overview-hero .header-style-control{margin-top:2px}.overview-hero #recommendation-basis{margin-left:auto;font-size:11px;min-height:28px}.overview-hero .flow-actions{display:none!important}body .overview-hero .live-scene{grid-column:1;grid-row:2;height:150px!important}#priority-signals{grid-column:1;grid-row:3;border-left:0;padding:0;border-top:1px solid var(--line)}.priority-label{padding-top:8px;font-size:11px}.priority-label small{display:block;font-size:10px}.priority-signal .priority-copy strong{font-size:15px}.priority-copy>span{font-size:11px;-webkit-line-clamp:1}body button.priority-signal{padding:8px 0;min-height:86px}.priority-copy small{font-size:10px}.priority-number{padding-top:17px}.focus-heading h2,.video-page-head h2{font-size:19px!important}.focus-heading .view-heading-actions{gap:3px}.focus-heading .view-heading-actions button{font-size:10px!important;padding:4px 6px!important}.focus-toolbar,.video-toolbar{flex-wrap:wrap;gap:6px}#focus-search,#video-search{max-width:none;width:100%;min-height:30px!important}.focus-tabs,#video-tabs{width:100%}.focus-tabs button,#video-tabs button{font-size:11px!important}body .signal-grid{grid-template-columns:minmax(0,1fr)}.focus-card h3,.focus-card:first-child h3{font-size:17px!important}.video-page-head{align-items:start!important}.video-actions{flex-shrink:0}.view-context{font-size:10px!important}}
