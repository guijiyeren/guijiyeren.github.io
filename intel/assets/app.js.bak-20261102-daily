function showSource(id){if(id==='newsnow'&&window.showNewsNowSource)return window.showNewsNowSource();const s=state.sources.find(s=>s.id===id);if(!s)return;drawer(`<h2>${esc(s.name)}</h2><span class="tag ${sourceState(s)==='good'?'good':'warn'}">${esc(sourceLabel(s))}</span><dl class="kv"><dt>接入方式</dt><dd>${esc(s.connector)}</dd><dt>来源属性</dt><dd>${esc(s.authority)}</dd><dt>授权状态</dt><dd>${esc(s.auth_state)}</dd><dt>最近成功</dt><dd>${date(s.last_success)}</dd><dt>近24小时接收</dt><dd>${s.accepted_24h}</dd><dt>近24小时过滤</dt><dd>${s.rejected_24h}</dd><dt>更新间隔</dt><dd>${s.interval_min} 分钟</dd><dt>下次允许运行</dt><dd>${date(s.next_attempt)}</dd><dt>最近错误</dt><dd>${esc(errorText(s.last_error))}</dd></dl><p>${esc(s.config.reason||'仅使用公开可访问的数据入口；单一来源发布不代表独立事实核实。')}</p><div class="drawer-actions">${s.connector==='manual'?'<button id="source-import">导入链接</button>':s.auth_state==='public'?'<button id="source-run">同步这个来源</button>':''}${s.auth_state==='public'?`<button id="source-toggle">${s.enabled?'暂停来源':'启用来源'}</button>`:''}</div>`);if($('#source-run'))$('#source-run').onclick=()=>syncOne(s.id);if($('#source-toggle'))$('#source-toggle').onclick=async()=>{try{await api('/sources/'+s.id,'PATCH',{enabled:!s.enabled});await load(false);showSource(s.id)}catch(e){toast(e.message)}};if($('#source-import'))$('#source-import').onclick=()=>importForm(s.id)}
function showSources(){drawer('<h2>信息源状态</h2>'+state.sources.map(s=>`<button class="candidate-row" data-source="${esc(s.id)}">${esc(s.name)}<span>${esc(sourceLabel(s))}</span></button>`).join(''));$('#drawer-body').querySelectorAll('[data-source]').forEach(b=>b.onclick=()=>showSource(b.dataset.source))}
async function syncOne(id){try{const r=await api('/sources/'+id+'/run','POST');toast('已开始同步，来源状态稍后更新');await pollRun(r.run_id);await load();if(!$('#drawer').hidden)showSource(id)}catch(e){toast(errorText(e.message))}}
async function pollRun(id){const until=Date.now()+300000;while(Date.now()<until){const r=await api('/runs/'+id);if(!['queued','running'].includes(r.status))return r;await new Promise(resolve=>setTimeout(resolve,1200))}throw Error('采集仍在进行，可稍后刷新查看')}
$('#sync').onclick=async()=>{if(syncing)return;syncing=true;$('#sync').disabled=true;$('#sync').textContent='同步中…';let failed=0;try{for(const s of state.sources.filter(s=>s.enabled&&!['manual','authorized','paid'].includes(s.connector)&&!s.connector.startsWith('ego_'))){try{const d=await api('/sources/'+s.id+'/run','POST');const r=await pollRun(d.run_id);if(r.status==='failed')failed++}catch(e){if(e.message!=='not_due')failed++}await load(false)}await load();toast(failed?'同步结束，部分来源失败或暂不可用，请查看状态':'公开来源同步结束')}catch(e){toast(e.message)}finally{syncing=false;$('#sync').disabled=false;$('#sync').textContent='同步公开来源'}};
const more=document.createElement('button');more.id='all-daily';more.textContent='查看今日清单';document.querySelector('#signals').previousElementSibling.appendChild(more);more.onclick=()=>{if(!state)return;drawer('<h2>今日情报清单</h2><p>最多展示10条达标情报。规则筛选并不等于完成事实核实。</p>'+state.daily_signals.map(e=>`<button class="candidate-row" data-event="${esc(e.id)}">${esc(e.title)}<span>${esc(e.category)} · ${esc(evidenceStatus(e.evidence_status))}</span></button>`).join(''));bindEvents($('#drawer-body'))};
$('#refresh').onclick=()=>load().catch(e=>toast(e.message));$('#draw').onclick=draw;$('#platforms').querySelectorAll('button').forEach(b=>b.onclick=()=>renderTrend(b.dataset.platform));
$('#candidates').onclick=async()=>{const box=$('#candidate-list');box.hidden=!box.hidden;if(box.hidden)return;try{const d=await api('/events?candidates=true&limit=30');box.innerHTML='<h3>候选验证区</h3><p class="muted">包含待核实或相关性不足的内容，不代表正式推荐。</p>'+d.items.map(e=>`<button class="candidate-row" data-event="${esc(e.id)}">${esc(e.title)}<span>${esc(evidenceStatus(e.evidence_status))} · ${esc(e.category)} · 规则相关分 ${e.relevance}</span></button>`).join('');if(!d.items.length)box.innerHTML+='<p class="muted">暂无候选。</p>';bindEvents(box)}catch(e){toast(e.message)}};
function importForm(platform='manual'){const source=['xiaohongshu','wechat'].includes(platform)?platform:'manual';drawer('<h2>导入分享链接</h2><p>仅导入你确认公开的标题、摘要和链接。提交后会将这里的文字发送至Google公开翻译网页，整理为中文；私人判断请写在收藏里，不会外发。不会读取登录内容。</p><form id="import-form"><label>原文链接<input id="import-url" type="url" required></label><label>原始标题<input id="import-title" maxlength="500" required></label><label>你有权使用的简要描述<textarea id="import-excerpt" rows="4" maxlength="1200"></textarea></label><div class="drawer-actions"><button class="primary" type="submit">导入待验证</button></div></form>');$('#import-form').onsubmit=async e=>{e.preventDefault();try{const r=await api('/import/links','POST',{source_id:source,url:$('#import-url').value,title:$('#import-title').value,excerpt:$('#import-excerpt').value,public_translation:true});toast(r.status==='accepted'?'已导入候选验证区':r.status==='duplicates'?'该线索已存在':'未通过准入或时效规则');closeDrawer();await load(false)}catch(error){toast(error.message)}}}
$('#retention').onclick=async()=>{try{const d=await api('/maintenance/retention/preview','POST');drawer('<h2>过期清理预览</h2><p>本次仅预览，没有删除数据。实际清理只处理过期临时对象，收藏与长期仓库不受影响。</p><dl class="kv">'+Object.entries(d.counts).map(([k,v])=>'<dt>'+esc(k)+'</dt><dd>'+v+'</dd>').join('')+'</dl><p>临时热点在到期后立即退出查询，手动启动的后端每15分钟回收一次。</p>')}catch(e){toast(e.message)}};
$('#collections').onclick=async()=>{try{const d=await api('/collections');drawer('<h2>长期收藏</h2>'+(d.items.length?d.items.map(c=>`<div class="evidence"><h3>${esc(c.title)}</h3><p>${esc(c.summary)}</p><p>${esc(c.decision)}</p><button data-export="${esc(c.id)}">导出选题草稿</button></div>`).join(''):'<p>尚未收藏。打开一条情报，写下判断后收藏。</p>'));$('#drawer-body').querySelectorAll('[data-export]').forEach(b=>b.onclick=async()=>{try{await api('/collections/'+b.dataset.export+'/export','POST');toast('选题草稿已生成，重复导出保留你的后续编辑')}catch(e){toast(e.message)}})}catch(e){toast(e.message)}};
