/* 2026-11-02：把「先看这两条」改成 第一条=国内外重点大事，第二条=AI/科技 */
(()=>{'use strict';
const q=s=>document.querySelector(s);
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let picks=[];
function row(it,label,num,sub){
  if(!it)return '';
  const src=sub||(it.appearances||[]).map(a=>a.name).filter(Boolean).slice(0,2).join(' · ');
  return '<button class="priority-signal hero-pick" data-url="'+esc(it.url)+'"><span class="priority-number">'+num+'</span><span class="priority-copy"><small>'+esc(label)+'</small><strong>'+esc(it.title)+'</strong><span>'+esc(src)+'</span></span><span aria-hidden="true">↗</span></button>';
}
function paint(){
  const box=q('#priority-signals');if(!box||!picks.length)return;
  box.querySelectorAll('.priority-signal:not(.hero-pick)').forEach(n=>n.remove());
  if(box.querySelector('.hero-pick'))return;
  const major=picks[0];
  const signals=(state?.focus_signals||[]).filter(x=>x.title);
  const ai=signals.find(x=>/AI|人工智能|大模型|芯片|科技|机器人|算力|智能体|OpenAI|英伟达/.test((x.personal_topic||'')+(x.title||'')))||signals[0]||picks.find(x=>/AI|人工智能|大模型|芯片|科技|机器人|算力|智能体|OpenAI|英伟达/.test(x.title))||picks[1]||picks[0];
  const aiSub=ai&&ai.personal_topic?ai.personal_topic:(ai&&ai.appearances?ai.appearances.map(a=>a.name).slice(0,2).join(' · '):'');
  box.insertAdjacentHTML('beforeend',row(major,'国内外 · 重点大事','01')+row(ai,'AI · 科技','02',aiSub));
  box.querySelectorAll('.hero-pick').forEach(b=>{b.onclick=()=>{const u=b.dataset.url;if(!u)return;if(window.parent!==window)parent.postMessage({type:'ATLAS_OPEN_URL',url:u},'app://obsidian.md');else window.open(u,'_blank','noopener');};});
}
async function load(){
  try{const d=await api('/major-events?limit=10');picks=d.items||[];}catch(e){}
  paint();
}
function watch(){
  const box=q('#priority-signals');
  if(!box){setTimeout(watch,500);return;}
  new MutationObserver(()=>{if(box.querySelector('.priority-signal:not(.hero-pick)'))paint();}).observe(box,{childList:true});
  load();
}
document.addEventListener('atlas:loaded',load);
watch();
})();
