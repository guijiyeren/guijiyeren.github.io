/* 2026-11-02 首页扩展 */
#home-extra{min-width:0}
.home-major{margin:0 0 18px;padding:11px 16px 12px;border:1px solid var(--line);border-radius:16px;background:var(--panel);overflow:hidden}
.hm-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.hm-eyebrow{font-size:10px;letter-spacing:.12em;color:var(--accent);font-weight:600}
.hm-count{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.hm-stage{min-height:112px;display:flex;align-items:center;justify-content:center}
.hm-stage.is-in .hm-item h3{animation:hmPop .62s cubic-bezier(.2,.9,.3,1.25)}
@keyframes hmPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:scale(1)}}
a.hm-item{display:block;width:100%;text-decoration:none;color:var(--text);padding:2px 0;text-align:center;transform-origin:center center}
.hm-scope{display:inline-flex;align-items:center;height:18px;padding:0 7px;border-radius:5px;background:var(--accent-soft);color:var(--accent);font-size:10px;font-weight:600;vertical-align:middle}
.hm-item h3{display:block;margin:6px auto 7px;max-width:960px;font-size:31px;line-height:1.32;font-weight:700;letter-spacing:-.6px;transform-origin:center center}
.hm-item p{display:flex;justify-content:center;flex-wrap:wrap;gap:4px 14px;margin:0;font-size:11px;color:var(--muted)}
.hm-item:hover h3{color:var(--accent)}
.home-github{margin:0 0 22px}
.hg-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 10px}
.hg-eyebrow{display:block;font-size:9px;letter-spacing:.12em;color:var(--accent);margin-bottom:3px}
.hg-head h2{font-size:19px;line-height:1.3;margin:0;letter-spacing:-.3px}
.hg-more{padding:4px 0;min-height:26px;background:none;border:0;color:var(--accent);font-size:12px;white-space:nowrap}
.hg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.hg-card{display:flex;flex-direction:column;padding:0;border:1px solid var(--line);border-radius:14px;background:var(--panel);overflow:hidden;text-align:left;color:var(--text);min-width:0;transition:border-color .2s,box-shadow .2s}
.hg-card:hover,.hg-card:focus-visible{border-color:color-mix(in srgb,var(--accent) 50%,var(--line));box-shadow:0 8px 24px color-mix(in srgb,var(--text) 6%,transparent)}
.hg-cover{display:block;aspect-ratio:16/9;background:var(--panel2);overflow:hidden}
.hg-cover img{display:block;width:100%;height:100%;object-fit:cover}
.hg-cover.is-empty{background:linear-gradient(135deg,var(--panel2),color-mix(in srgb,var(--accent) 12%,var(--panel2)))}
.hg-body{display:flex;flex-direction:column;gap:3px;padding:10px 12px 11px;min-width:0}
.hg-name{font-size:14.5px;font-weight:650;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hg-full{font-size:9.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hg-body p{margin:3px 0 0;font-size:11.5px;line-height:1.55;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.hg-meta{display:flex;align-items:center;gap:8px;margin-top:5px;font-size:10.5px;color:var(--muted)}
.hg-meta b{color:var(--text);font-weight:650}
.hg-meta i{color:var(--accent);font-style:normal}
.hg-meta em{margin-left:auto;font-style:normal;font-size:9.5px;padding:1px 6px;border-radius:5px;background:var(--panel2)}
@media(max-width:900px){.hg-grid{gap:10px}.hg-body p{min-height:32px}}
@media(max-width:700px){.hg-grid{grid-template-columns:minmax(0,1fr)}.hm-item h3{font-size:16px}.home-major{padding:10px 12px}}
@media(prefers-reduced-motion:reduce){.hm-stage.is-in .hm-item{animation:none}}
