/* ============================================================
   情报中枢 · 头部导航条（2026-11-01）
   一条粘在顶上的栏：左边项目图标 + 名字，右边按钮，下面一排栏目。
   栏目导航由 head-nav.js 从页面里挪进来，这里只管样式。
   ============================================================ */
:root{ --ph-hp:32px; --ph-head-h:84px; }
@media (max-width:1000px){ :root{ --ph-hp:22px } }
@media (max-width:650px){ :root{ --ph-hp:16px } }

/* 锚点跳转别被栏盖住（高度由 head-nav.js 写进 --ph-head-h） */
html{ scroll-padding-top:calc(var(--ph-head-h, 84px) + 6px) }

/* ---------- 栏体 ---------- */
body .shell > .page-head{
  position:sticky !important; top:0; z-index:30;
  display:flex !important; flex-wrap:wrap !important; align-items:center !important;
  column-gap:12px; row-gap:0;
  min-height:0 !important;
  margin:0 calc(var(--ph-hp) * -1) 14px !important;
  padding:7px var(--ph-hp) 0 !important;
  background:color-mix(in srgb, var(--bg) 90%, transparent);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
body .shell > .page-head.is-stuck{
  box-shadow:0 8px 22px color-mix(in srgb, var(--text) 7%, transparent);
}

/* ---------- 左：图标 + 名字 ---------- */
body .shell > .page-head > .ph-ident{
  display:flex; align-items:center; gap:9px; min-width:0;
}
body .shell > .page-head .ph-mark{
  width:26px; height:26px; flex:none; border-radius:8px;
  background:url("/assets/logos/atlas.png") center/cover no-repeat;
  box-shadow:0 0 0 1px color-mix(in srgb, var(--line) 85%, transparent);
}
body .shell > .page-head .title-line{ display:flex; align-items:center; gap:8px; min-width:0 }
body .shell > .page-head h1{
  font-size:19px !important; font-weight:700; letter-spacing:-.2px;
  margin:0 !important; line-height:1.3; white-space:nowrap;
}
body .shell > .page-head .tag{ font-size:10px; padding:1px 6px }

/* ---------- 右：动作按钮 ---------- */
body .shell > .page-head > .actions{
  margin-left:auto; display:flex; align-items:center; gap:6px; flex-wrap:wrap;
  padding-bottom:7px;
}
body .shell > .page-head > .actions button{ min-height:30px; padding:4px 10px; font-size:12px }
body .shell > .page-head > .actions > span{ font-size:11px; margin-right:2px }

/* ---------- 下：栏目导航 ---------- */
body .shell > .page-head > .section-nav{
  flex:0 0 100%; order:3;
  display:flex; align-items:stretch; gap:2px;
  margin:0 !important; padding:0 !important;
  min-height:0; border:0;
  overflow-x:auto; overflow-y:hidden; scrollbar-width:none;
}
body .shell > .page-head > .section-nav::-webkit-scrollbar{ display:none }
body .shell > .page-head > .section-nav a{
  flex:none; display:inline-flex; align-items:center;
  font-size:13.5px !important; font-weight:500; line-height:20px !important;
  padding:8px 10px 9px !important; margin:0 !important;
  color:var(--muted) !important; text-decoration:none;
  background:transparent; border:0 !important;
  border-bottom:2px solid transparent !important;
  border-radius:8px 8px 0 0;
  box-shadow:none !important; white-space:nowrap;
  transition:color .15s ease, background-color .15s ease, border-color .15s ease;
}
body .shell > .page-head > .section-nav a:hover{
  color:var(--text) !important;
  background:color-mix(in srgb, var(--text) 6%, transparent);
}
body .shell > .page-head > .section-nav a.active,
body .shell > .page-head > .section-nav a.is-current,
body .shell > .page-head > .section-nav a[aria-current]{
  color:var(--text) !important; font-weight:650;
  border-bottom-color:var(--accent) !important;
  background:transparent;
}

/* 视频情报整页阅读时，栏和导航照样在顶上 */
body.video-reading .shell > .page-head{ position:sticky !important }

/* ---------- 窄屏 ---------- */
@media (max-width:1000px){
  body .shell > .page-head{ column-gap:8px }
  body .shell > .page-head h1{ font-size:18px !important }
  body .shell > .page-head > .section-nav a{ font-size:13px !important; padding:7px 9px 8px !important }
}
@media (max-width:650px){
  body .shell > .page-head{
    flex-wrap:wrap !important; flex-direction:row !important;
    margin-bottom:10px !important; padding-top:6px !important;
  }
  body .shell > .page-head > .ph-ident{ flex:1 1 auto }
  body .shell > .page-head h1{ font-size:20px !important }
  body .shell > .page-head .ph-mark{ width:22px; height:22px; border-radius:7px }
  body .shell > .page-head > .actions{
    width:auto !important; flex-wrap:nowrap !important; padding-bottom:6px;
  }
  body .shell > .page-head > .actions button{ font-size:11px; min-height:28px; padding:3px 7px }
  body .shell > .page-head > .section-nav{ gap:0; margin:0 !important }
  body .shell > .page-head > .section-nav a{ font-size:12.5px !important; padding:7px 8px 8px !important }
}
